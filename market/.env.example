# Copy to market/.env (gitignored - the repository is public).

# Required for SEC EDGAR filings: your name and a contact email. SEC refuses
# requests without one (sec.gov/os/accessing-edgar-data).
SEC_USER_AGENT=

# Optional overrides
# BUTTERFLY_SPREAD=0.01        # cost per side of a trade (Kraken xStocks: 1%)
# BUTTERFLY_DATA=market/data
