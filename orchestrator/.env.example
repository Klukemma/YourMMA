# Copy to .env for local runs. In the cloud, set these in the host's dashboard.
# Never commit real values: this repository is public.

# Required
APP_PASSWORD=choose-a-long-password
OPENROUTER_API_KEY=sk-or-...

# Optional: better web search (https://tavily.com, free tier available)
TAVILY_API_KEY=

# Optional: lets agents clone private repos, push branches and open PRs.
# Use a fine-grained token limited to the repos you want them to touch.
AGENT_GITHUB_TOKEN=

# Spending limits (USD)
TASK_BUDGET_USD=5
DAILY_BUDGET_USD=25

# Override a model without editing agents.yaml
# MODEL_CODER=anthropic/claude-opus-5.5
# MODEL_CRITIC=openai/gpt-5

# Extra domains agents may download from, comma separated
# EXTRA_TRUSTED_DOMAINS=example.com
