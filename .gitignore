# Secrets - never commit real keys (this repo is public)
.env

# Python
__pycache__/
*.py[cod]
*.egg-info/
.venv/
venv/
.ipynb_checkpoints/

# OS
.DS_Store
Thumbs.db

# Dataset backups written by sync/repair/fix-units. Every pre-change state is
# already recoverable from git history, so tracking them doubles the repo for
# nothing.
engine/data/*.backup-*.csv

# A snapshot being written: nfl_approach writes a temporary file beside the
# target and renames it into place; one left by a killed run is never data.
nfl/data/*.tmp
